# Ohne DATABASE_URL läuft die API mit In-Memory-Speicher (nur Entwicklung)
DATABASE_URL=postgres://companygpt:companygpt@localhost:5432/companygpt
# Ohne REDIS_URL laufen Hintergrund-Jobs direkt im API-Prozess (nur Entwicklung)
REDIS_URL=redis://localhost:6379
JWT_SECRET=bitte-langes-zufaelliges-geheimnis-setzen
PLATFORM_DOMAIN=companygpt.local
PORT=8080
RATE_LIMIT_PER_MINUTE=120
# Sprachmodell & Embeddings (ohne Schlüssel: deterministische Demo-Provider)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
EMBEDDINGS_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
# Erster Plattform-Zugang (wird beim Seed angelegt)
PLATFORM_ADMIN_EMAIL=du@companygpt.demo
PLATFORM_ADMIN_PASSWORD=demo1234
